        {
            "variable": {
                "key": "BREAK",
                "value": "a\nb",
                "is_shown_once": false,
                "is_multiline": false,
                "is_literal": false,
                "is_buildtime": true,
                "is_runtime": true
            },
            "canView": "BREAK=(Value cannot be shown in this view, edit in normal view)",
