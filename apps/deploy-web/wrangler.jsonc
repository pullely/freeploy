{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "freeploy-deploy-web",
  "main": "worker/index.ts",
  "compatibility_date": "2025-05-01",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": false,
    "not_found_handling": "single-page-application"
  }
}
