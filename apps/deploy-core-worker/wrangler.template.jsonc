// Rendered to wrangler.jsonc by tooling/wire/render.mjs (BF6 deploy-time wiring).
// Resource IDs are NEVER committed: @@wiring(<component>/<env>:<key>)@@ tokens are
// resolved from AWS Secrets Manager at deploy time (wire-live) or from the
// committed wiring.fixture.json for offline dry-runs (wire-fixture).
{
  "name": "freeploy-deploy-core-worker",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  // Free plan caps a Worker at 3MB gzipped (10MB on paid) — minify fleet-wide
  // so the ceiling is never the thing that blocks a deploy.
  "minify": true,
  // SshSession (DP4) is a SQLite-backed Durable Object class with a container.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SshSession"] }],
  "vars": {
    "ENVIRONMENT": "local"
  },
  "env": {
    "dev": {
      "vars": {
        "ENVIRONMENT": "dev"
      }
    },
    "stage": {
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "stage"
      },
      // DP4: ssh-executor as a Cloudflare Container behind the SshSession Durable
      // Object, stage first (WAITING W3: the nexo token needs the Containers scope).
      "containers": [
        {
          "class_name": "SshSession",
          "image": "../ssh-executor/Dockerfile",
          "max_instances": 10
        }
      ],
      "durable_objects": {
        "bindings": [{ "name": "SSH_SESSION", "class_name": "SshSession" }]
      },
      "hyperdrive": [
        {
          "binding": "PLATFORM_DB",
          "id": "@@wiring(cloudflare-hyperdrive/stage:hyperdrive_id)@@"
        }
      ],
      "services": [
        {
          "binding": "MEMBERSHIP_WORKER",
          "service": "freeploy-membership-worker-stage"
        },
        {
          "binding": "POLICY_WORKER",
          "service": "freeploy-policy-worker-stage"
        }
      ]
    },
    "prod": {
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "prod"
      },
      "hyperdrive": [
        {
          "binding": "PLATFORM_DB",
          "id": "@@wiring(cloudflare-hyperdrive/prod:hyperdrive_id)@@"
        }
      ],
      "services": [
        {
          "binding": "MEMBERSHIP_WORKER",
          "service": "freeploy-membership-worker-prod"
        },
        {
          "binding": "POLICY_WORKER",
          "service": "freeploy-policy-worker-prod"
        }
      ]
    }
  }
}
