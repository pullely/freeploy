  {
    "find": "<button className=\"button\" type=\"button\">(?:\\s|\\{\" \"\\})*<span>Browse\u2026</span>(?:\\s|\\{\" \"\\})*</button>",
    "replace": "<button className=\"button\" type=\"button\" disabled={props.avatarBusy} onClick={() => document.getElementById(\"avatar-input\")?.click()}>\n                          <span>{props.avatarBusy ? \"Uploading\u2026\" : \"Browse\u2026\"}</span>\n                        </button>\n                        {props.avatarUrl ? (<button className=\"button button-error\" type=\"button\" disabled={props.avatarBusy} onClick={props.onAvatarRemove}>Remove</button>) : null}",
    "props": [
      "avatarBusy: boolean",
      "onAvatarRemove: () => void"
    ]
  },
  {
    "find": "<p className=\"text-xs text-red-500\" style=\\{\\{ \"display\": \"none\" \\}\\} />",
    "replace": "<p className=\"text-xs text-red-500\" {...(props.avatarError ? {} : { style: { \"display\": \"none\" } })}>{props.avatarError}</p>",
    "props": [
      "avatarError: string | null"
    ]
  }
