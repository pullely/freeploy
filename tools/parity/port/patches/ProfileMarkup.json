  },
  {
    "find": "<input type=\"file\" accept=\"image/jpeg,image/png,image/webp\" className=\"hidden\" />",
    "replace": "<input type=\"file\" accept=\"image/jpeg,image/png,image/webp\" className=\"hidden\" id=\"avatar-input\" onChange={props.onAvatarFile} />",
