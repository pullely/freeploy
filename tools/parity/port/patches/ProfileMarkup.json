    "once": true,
    "props": [
      "onChangeEmail: () => void",
      "emailDialogOpen: boolean"
    ]
  },
  {
    "find": "(<div className=\"mt-2 max-w-2xl space-y-2 text-\\[13px\\] leading-5 text-neutral-600 dark:text-fg-dim\">)[\\s\\S]*?</ul>(?:\\s|\\{\" \"\\})*</div>",
    "replace": "$1{props.deletionText}</div>",
    "once": true,
    "props": [
      "deletionText?: ReactNode"
    ]
  },
  {
    "find": "<span className=\"relative inline-flex\" tabIndex=\\{0\\}>(?:\\s|\\{\" \"\\})*<button disabled className=\"button button-error\" type=\"button\">\\{\" \"\\}Delete account\\{\" \"\\}</button>[\\s\\S]*?</span>",
    "replace": "{props.deletionAction}",
    "once": true,
    "props": [
      "deletionAction?: ReactNode"
    ]
  },
  {
    "find": "<img alt=\"Profile picture preview\" className=\"h-full w-full object-cover\" style=\\{\\{ \"display\": \"none\" \\}\\} />",
    "replace": "<img alt=\"Profile picture preview\" className=\"h-full w-full object-cover\" {...(props.avatarPreview ? { src: props.avatarPreview } : { style: { \"display\": \"none\" } })} />",
    "props": [
      "avatarPreview: string | null"
    ]
  },
  {
    "find": "<span>\\{\" \"\\}[A-Z]\\{\" \"\\}</span>",
