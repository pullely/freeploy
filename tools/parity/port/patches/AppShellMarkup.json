[
  {
    "find": "https://github\\.com/coollabsio/coolify/releases/tag/v[0-9a-f]+",
    "replace": "https://github.com/pullely/freeploy"
  },
  {
    "find": "https://coolify\\.io[^\"]*",
    "replace": "https://github.com/pullely/freeploy"
  },
  {
    "find": "data-page-context=\"Profile\"",
    "replace": "data-page-context={props.pageTitle}",
    "props": [
      "pageTitle: string"
    ]
  },
  {
    "find": "<a href=\"/profile\" (className=\"flex h-8 min-w-0 items-center truncate[^\"]*\")>Profile</a>",
    "replace": "<a href={props.pageHref} $1>{props.pageTitle}</a>",
    "props": [
      "pageHref: string"
    ]
  },
  {
    "find": "title=\"Search this page and everything \\(Press / or Ctrl\\+K, then Tab to switch\\)\"",
    "replace": "title={props.searchTitle}",
    "props": [
      "searchTitle: string"
    ]
  },
  {
    "find": "<a title=\"([^\"]+)\" href=\"([^\"]+)\" className=\"menu-item\">",
    "replace": "<a title=\"$1\" href=\"$2\" {...props.nav(\"$2\")}>",
    "props": [
      "nav: (href: string) => { className: string; \"aria-current\"?: \"page\" }"
    ]
  },
  {
    "find": "<main className=\"app-main [^\"]*\">",
    "replace": "<main className={props.mainClass}>",
    "props": [
      "mainClass: string"
    ]
  },
  {
    "find": "title=\"Team: (?:Root Team|Parity Root's Team|Parity User's Team)\"",
    "replace": "title={`Team: ${props.teamName}`}"
  },
  {
    "find": ">(\\{\" \"\\})?(?:Root Team|Parity Root's Team|Parity User's Team)(\\{\" \"\\})?<",
    "replace": ">$1{props.teamName}$2<",
    "props": [
      "teamName: string"
    ]
  },
  {
    "find": "(<span className=\"flex shrink-0 items-center justify-center rounded-md [^\"]*\">)(\\{\" \"\\})?[A-Z](\\{\" \"\\})?<",
    "replace": "$1$2{props.teamInitial}$3<",
    "props": [
      "teamInitial: string"
    ]
  },
  {
    "find": "aria-label=\"Account menu for (?:Parity Root|Parity User)\"",
    "replace": "aria-label={`Account menu for ${props.userName}`}"
  },
  {
    "find": "(title|alt)=\"(?:Parity Root|Parity User)\"",
    "replace": "$1={props.userName}"
  },
  {
    "find": ">(\\{\" \"\\})?(?:Parity Root|Parity User)(\\{\" \"\\})?<",
    "replace": ">$1{props.userName}$2<",
    "props": [
      "userName: string"
    ]
  },
  {
    "find": "(<span className=\"flex size-5 shrink-0 items-center justify-center rounded-full [^\"]*\")>(\\{\" \"\\})?[A-Z](\\{\" \"\\})?<",
    "replace": "$1 {...(props.avatarUrl ? { style: { \"display\": \"none\" } } : {})}>$2{props.userInitial}$3<",
    "props": [
      "userInitial: string"
    ]
  },
  {
    "find": ">(\\{\" \"\\})?(?:root|user)@example\\.com(\\{\" \"\\})?<",
    "replace": ">$1{props.userEmail}$2<",
    "props": [
      "userEmail: string"
    ]
  },
  {
    "find": "<form action=\"/logout\" method=\"POST\">",
    "replace": "<form action=\"/logout\" method=\"POST\" onSubmit={props.onLogout}>",
    "props": [
      "onLogout: FormEventHandler<HTMLFormElement>"
    ]
  },
  {
    "find": "<span>((?:\\s*\\{\" \"\\})?\\s*<div className=\"fixed bottom-0 right-0[^\"]*\">(?:\\s*\\{\" \"\\})?\\s*<div className=\"relative mx-auto flex w-full flex-col overflow-hidden rounded-2xl)",
    "replace": "<span style={props.reminderStyle}>$1",
    "props": [
      "reminderStyle?: { display: \"none\" }"
    ]
  },
  {
    "find": "<button type=\"button\" aria-label=\"Dismiss notifications reminder\"",
    "replace": "<button type=\"button\" aria-label=\"Dismiss notifications reminder\" onClick={props.onDismissReminder}",
    "props": [
      "onDismissReminder: () => void"
    ]
  },
  {
    "find": "<button type=\"button\" className=\"button h-9 justify-center sm:min-w-32\">",
    "replace": "<button type=\"button\" className=\"button h-9 justify-center sm:min-w-32\" onClick={props.onDismissReminder}>"
  },
  {
    "find": "<ul className=\"(fixed z-9999 [^\"]*)\" data-teleport-target=\"true\" />",
    "replace": "<ul className=\"$1\" data-teleport-target=\"true\">{props.toasts}</ul>",
    "props": [
      "toasts?: ReactNode"
    ]
  },
  {
    "find": "<img alt=\\{props\\.userName\\} className=\"size-5 shrink-0 rounded-full object-cover\" style=\\{\\{ \"display\": \"none\" \\}\\} />",
    "replace": "<img alt={props.userName} className=\"size-5 shrink-0 rounded-full object-cover\" {...(props.avatarUrl ? { src: props.avatarUrl } : { style: { \"display\": \"none\" } })} />",
    "props": [
      "avatarUrl: string | null"
    ]
  },
  {
    "find": "<li className=\"contents\" style=\\{\\{ \"display\": \"none\" \\}\\}>(\\s*)<ul role=\"list\" className=\"flex flex-col gap-y-0\\.5\">(?=\\s*<li className=\"mb-1\">\\s*<button type=\"button\" title=\"Back to the main menu\"[^>]*>[\\s\\S]*?<span className=\"flex-1 truncate pr-6 [^\"]*\">([^<]+)</span>)(?=[\\s\\S]*<ul role=\"list\" className=\"sidebar-menu )",
    "replace": "<li className=\"contents\" {...props.mobileMenu.panel(\"$2\")}>$1<ul role=\"list\" className={props.mobileMenu.list}>",
    "props": [
      "mobileMenu: { panel: (label: string) => { style?: { display: \"none\" }; \"data-active-submenu\"?: string }; parent: (label: string) => { className: string; onClick: () => void }; back: () => void; list: string }"
    ]
  },
  {
    "find": "<li className=\"contents\">(\\s*)<ul role=\"list\" className=\"flex flex-col gap-y-0\\.5\">(?=[\\s\\S]*<ul role=\"list\" className=\"sidebar-menu )",
    "replace": "<li className=\"contents\" {...props.mobileMenu.panel(\"\")}>$1<ul role=\"list\" className={props.mobileMenu.list}>"
  },
  {
    "find": "(<button type=\"button\" title=\"Back to the main menu\" aria-label=\"Back to the main menu\" className=\"[^\"]*\")>(?=[\\s\\S]*<ul role=\"list\" className=\"sidebar-menu )",
    "replace": "$1 onClick={props.mobileMenu.back}>"
  },
  {
    "find": "<button type=\"button\" title=\"([^\"]+)\" className=\"menu-item w-full\">(?=[\\s\\S]*<ul role=\"list\" className=\"sidebar-menu )",
    "replace": "<button type=\"button\" title=\"$1\" {...props.mobileMenu.parent(\"$1\")}>"
  },
  {
    "find": "<li className=\"contents\" style=\\{\\{ \"display\": \"none\" \\}\\}>(\\s*)<ul role=\"list\" className=\"flex flex-col gap-y-0\\.5\">(?=\\s*<li className=\"mb-1\">\\s*<button type=\"button\" title=\"Back to the main menu\"[^>]*>[\\s\\S]*?<span className=\"flex-1 truncate pr-6 [^\"]*\">([^<]+)</span>)",
    "replace": "<li className=\"contents\" {...props.desktopMenu.panel(\"$2\")}>$1<ul role=\"list\" className={props.desktopMenu.list}>",
    "props": [
      "desktopMenu: { panel: (label: string) => { style?: { display: \"none\" }; \"data-active-submenu\"?: string }; parent: (label: string) => { className: string; onClick: () => void }; back: () => void; list: string }"
    ]
  },
  {
    "find": "<li className=\"contents\">(\\s*)<ul role=\"list\" className=\"flex flex-col gap-y-0\\.5\">",
    "replace": "<li className=\"contents\" {...props.desktopMenu.panel(\"\")}>$1<ul role=\"list\" className={props.desktopMenu.list}>"
  },
  {
    "find": "(<button type=\"button\" title=\"Back to the main menu\" aria-label=\"Back to the main menu\" className=\"[^\"]*\")>",
    "replace": "$1 onClick={props.desktopMenu.back}>"
  },
  {
    "find": "<button type=\"button\" title=\"([^\"]+)\" className=\"menu-item w-full\">",
    "replace": "<button type=\"button\" title=\"$1\" {...props.desktopMenu.parent(\"$1\")}>"
  }
]
