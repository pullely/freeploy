[
  {
    "find": "<p>[^<]*&#039;s Team requires two-factor authentication\\. Configure it to continue\\.</p>",
    "replace": "<p>{props.teamName} requires two-factor authentication. Configure it to continue.</p>",
    "props": [
      "teamName: string"
    ]
  },
  {
    "find": "<form action=\"/user/two-factor-authentication\" method=\"POST\">",
    "replace": "<form action=\"/user/two-factor-authentication\" method=\"POST\" onSubmit={props.onConfigure}>",
    "props": [
      "onConfigure: FormEventHandler<HTMLFormElement>"
    ]
  },
  {
    "find": "(<form action=\")http://(?:127\\.0\\.0\\.1|localhost):8000(/two-factor-required/switch-team\" method=\"POST\">)[\\s\\S]*?</form>",
    "replace": "{props.switchTeams}",
    "props": [
      "switchTeams: ReactNode"
    ]
  },
  {
    "find": "<form action=\"/logout\" method=\"POST\">",
    "replace": "<form action=\"/logout\" method=\"POST\" onSubmit={props.onLogout}>",
    "props": [
      "onLogout: FormEventHandler<HTMLFormElement>"
    ]
  }
]
